  "fallback_novo_pacote": {

    "when": "subtópico não está em pacotes",

    "steps": [

      "Confirmar nome exato em CLAUDE.md §9",

      "npm run catalog:export-lote -- --lote=<slug>-completo --subtopico=\"Nome\" --limit=10000",

      "Criar entrada em handcraft-registry.json (pacote_prefix, manifest, lote_pattern, lote_size: 8)",

      "Seguir docs/GOLDEN_HANDCRAFT_MODEL.md e perioperatoria-completo/README.md como molde",

      "Handcraft em lotes g01, g02… até esgotar manifest — sem catalog:upgrade-premium"

    ],

    "slugify_hint": "minúsculas, sem acentos, hífens (ex.: saude-da-crianca)"

