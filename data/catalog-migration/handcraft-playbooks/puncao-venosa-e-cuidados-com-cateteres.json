{
  "version": 2,
  "subtopico": "Punção Venosa e Cuidados com Cateteres",
  "pacote_prefix": "puncao-venosa-e-cuidados-com-cateteres",
  "scope_default": "subtopico_handcraft",
  "anchor_glob": "examples/questao-premium-*-puncao-*.json,examples/questao-premium-admtec-puncao-venosa-cateteres.json",
  "guideline": "lib/guidelines/puncaoVenosa.ts",
  "golden_anchors_registry": "data/catalog-migration/puncao-venosa-e-cuidados-com-cateteres-golden-anchors.json",
  "handcraft_meta": "data/catalog-migration/puncao-venosa-e-cuidados-com-cateteres-completo/handcraft-meta.json",
  "cluster_report": "artifacts/puncao-topic-cluster-report.json",
  "repair_lote_pattern": "puncao-venosa-e-cuidados-com-cateteres-*-repair",
  "slug_selection": "P0 puncao_flebite → g01; depois dispositivo, exceto, tempo, periférica, ipcs, genérico por cluster",
  "clusters": [
    "Flebite e complicações (19 · 17,3% — puncao_flebite · g01)",
    "Dispositivo / calibre / jelco (12 · 10,9% — puncao_dispositivo · g02)",
    "EXCETO — técnica / conduta (12 · 10,9% — puncao_exceto · g03)",
    "Tempo / observação pós-procedimento (13 · 11,8% — puncao_tempo · g04)",
    "Punção venosa periférica (19 · 17,3% — puncao_periferica_antissepsia · g05)",
    "Prevenção de IPCS no CVC (11 · 10% — puncao_ipcs_cvc · g06)",
    "Cauda genérica / protocolo (24 · 21,8% — puncao_generico · g07+)"
  ],
  "pedagogical_branches": [
    {
      "id": "puncao_flebite",
      "when": "Infiltração, flebite, extravasamento, hematoma, complicações locais do acesso",
      "mold": "iv-complication-orbit · iv-differential-board · iv-complication-tap-flow · iv-label-swap-trap",
      "anchors": ["examples/questao-premium-avancasp-puncao-infiltracao-flebite.json"]
    },
    {
      "id": "puncao_dispositivo",
      "when": "Calibre, jelco, scalp, dispositivo, gauge",
      "mold": "iv-gauge-matrix · iv-device-reference-board · iv-device-tap-flow · iv-gauge-mismatch-trap",
      "anchors": ["examples/questao-premium-gama-puncao-scalp-jelco-calibre.json"]
    },
    {
      "id": "puncao_exceto",
      "when": "EXCETO / INCORRETA em técnica ou conduta de punção/cateter",
      "mold": "iv-exceto-spectrum · iv-exceto-command-board · iv-exceto-tap-flow · iv-exceto-intruder-trap",
      "anchors": ["examples/questao-premium-cev-urca-puncao-exceto-med-endovenosa.json"]
    },
    {
      "id": "puncao_tempo",
      "when": "Troca de equipos, intervalos, tempo de observação, validade",
      "mold": "iv-interval-timeline · iv-interval-board · iv-interval-tap-flow · iv-interval-swap-trap",
      "anchors": ["examples/questao-premium-cpcon-puncao-troca-equipos-intervalos.json"]
    },
    {
      "id": "puncao_periferica_antissepsia",
      "when": "Técnica de punção periférica, antissepsia, ordem do procedimento",
      "mold": "iv-puncture-rail · iv-antisepsis-board · iv-puncture-tap-flow · iv-order-invert-trap",
      "anchors": ["examples/questao-premium-funpar-puncao-tecnica-periferica.json"]
    },
    {
      "id": "puncao_ipcs_cvc",
      "when": "Bundle CVC, IPCS, barreira máxima, corrente sanguínea",
      "mold": "iv-bundle-orbit · iv-bundle-mesh-reveal · iv-bundle-tap-flow · iv-bundle-break-trap",
      "anchors": ["examples/questao-premium-admtec-puncao-venosa-cateteres.json"],
      "review_axes": [
        "hub — desinfecção da conexão / álcool 70% a cada manipulação",
        "curativo — troca asséptica / não esperar infecção; não confundir com hub",
        "flush — manutenção contínua do lúmen (não só na inserção)",
        "flebite — sinais locais e conduta (eixo vizinho; só se o enunciado ancorar)"
      ],
      "pedagogy_bar": "1 eixo por card; danger_zone cobre todas as letras erradas + transferência; densidade ≤110 chars"
    },
    {
      "id": "puncao_generico",
      "when": "Cauda sem cluster forte, protocolo misto",
      "mold": "bridge · reference_table · cards · compare",
      "anchors": ["examples/questao-premium-gama-puncao-scalp-jelco-calibre.json"]
    }
  ],
  "validation": {
    "per_slug": "npm run audit:questao-readiness -- --file=<path> --strict-v2-pedagogy",
    "per_lote_l1": "npm run validate:goldens -- --lote=<lote> --strict && npm run audit:questao-readiness -- --lote=<lote> --strict-v2-pedagogy",
    "per_lote_l2": "npm run audit:slug-alignment -- --lote=<lote> --strict",
    "per_lote_l2b": "npm run audit:numeric-factcheck -- --lote=<lote>",
    "per_lote_l6": "npm run audit:anchor-review -- --lote=<lote> --record-pass --reviewer=<revisor>",
    "enrich_guideline_meta": "npm run enrich:puncao-guideline-meta -- --lote=<lote> --write",
    "a4_minimo": "npm run stamp:puncao-a4-minimo -- --lote=<lote>",
    "a4_minimo_doc": "docs/PROTOCOLO_A4_MINIMO_PUNCAO.md"
  },
  "a4_minimo": {
    "enabled": true,
    "agent": "agent:puncao-a4-minimo-v1",
    "whitelist_module": "lib/catalogMigration/puncaoA4Minimo.ts",
    "human_always": ["family=calc", "claim fora da whitelist", "forbid hit", "fonte só tier B", "divergência real prova×guideline"],
    "sample_rate_medio": 0.2
  },
  "first_lote": "puncao-venosa-e-cuidados-com-cateteres-g01",
  "modes": {
    "subtopico_handcraft": {
      "label": "Handcraft golden-v1 — 110 slugs em lotes puncao-venosa-e-cuidados-com-cateteres-gNN",
      "first_lote": "puncao-venosa-e-cuidados-com-cateteres-g01",
      "batch_size": 8,
      "after_handcraft": [
        "npm run validate:goldens -- --lote=<lote> --strict",
        "npm run audit:questao-readiness -- --lote=<lote> --strict-v2-pedagogy",
        "npm run audit:slug-alignment -- --lote=<lote> --strict",
        "npm run audit:numeric-factcheck -- --lote=<lote>",
        "npm run enrich:puncao-guideline-meta -- --lote=<lote> --write",
        "npm run catalog:patch-pedagogical-branch -- --lote=<lote> --reconcile-branch --apply",
        "npm run capture:questao-review -- --lote=<lote>",
        "npm run audit:anchor-review -- --lote=<lote> --record-pass --reviewer=<revisor>",
        "npm run catalog:apply-lote -- --lote=<lote> --dry-run",
        "# apply SOMENTE se usuário pedir:",
        "npm run catalog:apply-lote -- --lote=<lote> --apply"
      ]
    },
    "single_slug": {
      "after_handcraft": [
        "npm run enrich:puncao-guideline-meta -- --file=data/catalog-migration/<lote>/questions/<slug>.json --write",
        "npm run audit:questao-readiness -- --file=data/catalog-migration/<lote>/questions/<slug>.json --strict-v2-pedagogy"
      ]
    }
  },
  "after_handcraft": [
    "reconcile:handcraft-manifest",
    "catalog:preflight em todos g*",
    "audit:subtopico-quality -- --subtopico=\"Punção Venosa e Cuidados com Cateteres\" --promote"
  ]
}
