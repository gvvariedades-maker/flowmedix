{
  "version": 1,
  "subtopico": "Vias de Administração",
  "pacote_prefix": "vias-de-administracao",
  "scope_default": "subtopico_handcraft",
  "anchor_glob": "examples/questao-premium-*-vias-*.json,examples/questao-premium-consulpam-vias-absorcao-oral.json",
  "golden_anchors_registry": "data/catalog-migration/vias-golden-anchors.json",
  "handcraft_meta": "data/catalog-migration/vias-de-administracao-completo/handcraft-meta.json",
  "repair_lote_pattern": "vias-de-administracao-repair-*",
  "slug_selection": "Cluster absorção/1ª passagem ou técnica de punção; audit [READY]; ou Slug: explícito",
  "clusters": [
    "Absorção farmacocinética / 1ª passagem (âncora Consulpam CORRETA)",
    "Indicação da via (velocidade SC/IM/IV)",
    "Técnica de administração (IM, IV, punção)",
    "V/F assertivas I–III ou I–IV"
  ],
  "pedagogical_branches": [
    {
      "id": "via_vf_absorcao",
      "when": "Absorção, 1ª passagem hepática, oral/sublingual/retal/parenteral, comparativo de vias",
      "mold": "absorption-speed-rail · reference_table · tap · route-trap",
      "anchors": [
        "examples/questao-premium-consulpam-vias-absorcao-oral.json",
        "examples/questao-premium-vunesp-via-subcutanea.json"
      ]
    },
    {
      "id": "via_tecnica_admin",
      "when": "Técnica de punção, sítio anatômico, volume, ângulo, complicações",
      "mold": "genérico morphological · reference_table · vertical · compare",
      "anchors": ["examples/questao-premium-cpcon-vias-im-vf.json"]
    },
    {
      "id": "via_generico",
      "when": "Demais — indicação de via sem cluster claro",
      "mold": "genérico",
      "anchors": ["examples/questao-premium-vunesp-via-subcutanea.json"]
    }
  ],
  "validation": {
    "per_slug": "npm run audit:questao-readiness -- --file=<path>",
    "lote": "npm run audit:questao-readiness -- --lote=<lote>"
  },
  "proibido": ["ai:generate", "catalog:upgrade-premium"]
}
