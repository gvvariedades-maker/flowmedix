# ============================================================================
# VARIÁVEIS DE AMBIENTE - AVANT
# ============================================================================
# Copie este arquivo para .env.local e preencha com seus valores

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Opcional — MCP Cursor (.cursor/mcp.json) e scripts de ops (npm run supabase:max-rows)
# Gere em https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx

# URL pública da aplicação (links em e-mails, SEO, redirects)
NEXT_PUBLIC_APP_URL=https://avant.enf.br

# Suporte via WhatsApp (opcional — padrão 5584998049641 no código)
# NEXT_PUBLIC_WHATSAPP_NUMBER=5584998049641

# Baseline / perf em preview Vercel — copie .env.staging.example → .env.staging.local
# npm run perf:baseline:staging   npm run perf:smoke:staging
# Preview com Deployment Protection: VERCEL_PROTECTION_BYPASS no .env.staging.local

# Resend (e-mails transacionais)
RESEND_API_KEY=re_xxxxxxxx
# Remetente verificado no painel Resend (domínio avant.enf.br)
RESEND_FROM_EMAIL=Avant <noreply@avant.enf.br>

# Google Gemini API (Opcional - para funcionalidades de IA)
GOOGLE_API_KEY=your_google_api_key

# Environment
NODE_ENV=development

# Admin — e-mail exato da conta Supabase com acesso ilimitado e /admin
# Obrigatório em Vercel Production / next build local (ADMIN_EMAIL ou ADMIN_EMAILS).
# Preview Vercel (VERCEL_ENV=preview) não bloqueia o build se ausente.
ADMIN_EMAIL=gvvariedades@gmail.com
# Opcional: admins adicionais separados por vírgula
# ADMIN_EMAILS=outro_admin@exemplo.com

# Concurso usado em /admin/concursos/[id]/matriculas (liberar acesso por e-mail)
# ADMIN_MATRICULAS_CONCURSO_ID=c3e001fb-3b82-4bad-8097-8db842649bb9

# Rate limit distribuído (Vercel Marketplace → Upstash for Redis)
# A integração injeta KV_REST_API_URL + KV_REST_API_TOKEN em production.
# Manual / Upstash console:
# UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Segurança - obrigatório em produção
# Supabase: cache (triggers pg_net → /api/cache/revalidate) + Auth (INSERT auth.users)
# Gere: openssl rand -hex 32 — mesmo valor na Vercel e no GUC app.webhook_secret (SQL Editor)
SUPABASE_WEBHOOK_SECRET=coloque_o_hex_gerado_pelo_openssl_rand_hex_32
# Legado (opcional): fallback no /api/cache/revalidate se SUPABASE_WEBHOOK_SECRET ausente
# WEBHOOK_SECRET=seu_secret_antigo
METRICS_SECRET=seu_secret_para_metricas

# Stripe (checkout de concursos)
# STRIPE_SECRET_KEY e STRIPE_WEBHOOK_SECRET habilitam checkout/webhook no servidor.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY é opcional para Checkout redirect; necessária para Stripe Elements no client.
STRIPE_SECRET_KEY=sk_test_sua_chave_secreta
STRIPE_WEBHOOK_SECRET=whsec_seu_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sua_chave_publica

# Assinatura AVANT Pro (Stripe Price ID recorrente — concurso slug `geral`)
STRIPE_PRICE_ID_PRO=price_seu_price_id_pro

# Cron (expiração de matrículas na Vercel)
# Obrigatório em produção quando Stripe/checkout estiver ativo; opcional em dev local.
CRON_SECRET=seu_secret_para_cron

# Sentry (observabilidade / crash reporting) — TODAS opcionais.
# Sem DSN o Sentry fica desativado (no-op) e a app usa o seam /api/client-error.
# NEXT_PUBLIC_SENTRY_DSN habilita o client; SENTRY_DSN o servidor (cai para o
# público se só este existir). Use o mesmo DSN do projeto Sentry em ambos.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@oXXXX.ingest.sentry.io/XXXX
# SENTRY_DSN=https://xxxxx@oXXXX.ingest.sentry.io/XXXX
# Upload de source maps (somente CI/Vercel — desminifica stack traces):
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxx
# SENTRY_ORG=sua-org
# SENTRY_PROJECT=avant

# ============================================================================
# NOTAS:
# - NUNCA commite o arquivo .env.local no Git
# - NEXT_PUBLIC_* são expostas ao cliente, use com cuidado
# - SERVICE_ROLE_KEY tem acesso total ao banco, mantenha segura
# - STRIPE_SECRET_KEY e STRIPE_WEBHOOK_SECRET são somente de servidor; não exponha no client
# ============================================================================
