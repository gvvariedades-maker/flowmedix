{
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=6144",
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  },
  "crons": [
    {
      "path": "/api/admin/manutencao/expirar-matriculas",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/admin/manutencao/simulado-retention",
      "schedule": "0 4 1 * *"
    },
    {
      "path": "/api/simulado/weekly/generate",
      "schedule": "0 6 * * 1"
    }
  ]
}
