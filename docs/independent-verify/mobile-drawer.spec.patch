+/** BottomNav fica `pointer-events-none` enquanto welcome/modal bloqueia — espera interação real. */
+async function waitForBottomNavInteractive(page: Page) {
+  await page.waitForFunction(() => {
+    const nav = document.querySelector('nav[aria-label="Navegação rápida"]');
+    if (!nav) return false;
+    return window.getComputedStyle(nav).pointerEvents !== 'none';
+  });
+}
