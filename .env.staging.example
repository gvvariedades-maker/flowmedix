# ============================================================================
# Baseline / perf contra STAGING (preview Vercel)
# ============================================================================
# Copie para .env.staging.local (gitignored via .env*.local):
#   copy .env.staging.example .env.staging.local
#
# Mantenha no .env.local as chaves Supabase (mesmo projeto que o staging usa).
# Este arquivo sobrescreve só o host do app ao rodar:
#   npm run perf:baseline:staging
#   npm run perf:smoke:staging

# URL pública do deploy de staging / preview (sem barra final)
PERF_BASE_URL=https://sua-preview.vercel.app
NEXT_PUBLIC_APP_URL=https://sua-preview.vercel.app

# Opcional: e-mail do aluno de teste (magic link no baseline). Se omitido, usa matrícula ativa ou ADMIN_EMAIL.
# PERF_BASELINE_EMAIL=aluno.staging@exemplo.com

# Opcional: Bearer para GET /api/metrics no staging
# METRICS_SECRET=

# Preview com Deployment Protection (Vercel → Settings → Deployment Protection → Protection Bypass for Automation)
# VERCEL_PROTECTION_BYPASS=seu_secret_de_automation_bypass

# Modal questão sobre vitrine (fase 11.2) — opt-in no deploy Vercel:
# NEXT_PUBLIC_ESTUDAR_MODAL_ROUTE=1

# Telemetria navegação estudar (baseline staging):
# NEXT_PUBLIC_ESTUDAR_NAV_TELEMETRY=1

# Opcional: outro arquivo de env (caminho relativo à raiz do repo)
# PERF_ENV_FILE=.env.staging.local
